# Samsung Branch Operations - Environment Variables Example
# DO NOT COMMIT REAL CREDENTIALS OR KEYS TO THIS FILE OR GIT

# Application Mode: DEVELOPMENT | ENTERPRISE
APP_ENV=DEVELOPMENT
APP_VERSION=2026.09-v1

# Authentication Provider (Future Enterprise Integration)
# AUTH_PROVIDER=ENTRA_ID
# ENTRA_CLIENT_ID=
# ENTRA_TENANT_ID=

# Branch Information
BRANCH_CODE=CPW-AYUTTHAYA-CITY-PARK
BRANCH_NAME=Samsung Ayutthaya City Park 1st Floor

# Claude Vision API (Server-Side Vercel Environment Variable Only)
# DO NOT COMMIT REAL KEYS TO GIT - Set this exclusively in Vercel Project Settings Dashboard
CLAUDE_API_KEY=
CLAUDE_VISION_MODEL=claude-3-5-sonnet-20241022
